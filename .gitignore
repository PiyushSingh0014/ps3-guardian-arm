# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*-venv/

# Models, weights and build outputs: never commit these.
# They are large (the .pte is ~1 GB, over GitHub's 100 MB limit) and the
# Llama weights and anything exported from them are covered by Meta's licence.
*.pte
*.pth
*.bin
*.safetensors
*.gguf
tokenizer.model
llama_main
*.so
cmake-out/
*.joblib

# Datasets: download them with the scripts (their licences differ)
data/
*.csv
!detectors/sms/sample_messages.csv
*.pcap
*.pcapng

# Runtime output
logs/
*.log
.cache/

# ESP32 lab device: the Wi-Fi password and the pairing token stay on the laptop
esp32/**/secrets.h
# Phone Guard's link model (update 43): the same numbers as detectors/url/url_model.npz, which is in git too
!android/app/src/main/assets/guard/link_model.bin
