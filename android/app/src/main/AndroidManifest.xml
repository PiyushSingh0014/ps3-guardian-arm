<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Read incoming SMS (the app never sends, deletes or changes SMS). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Talk to the Home Hub (the Pi) on your home Wi-Fi. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Show scam alerts (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Sajag"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.PS3Guardian">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One alert's own screen (app 3.0), opened from the lists and from notifications. -->
        <activity
            android:name=".AlertActivity"
            android:exported="false" />

        <!-- Set-up: allow the checks, pair with the Home Hub, copy Llama. -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Check with Sajag": a file (or a message's text) from WhatsApp, Messages or the
             Files app is checked on the Home Hub. Android lets the app read only that one file. -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:label="Check with Sajag">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- Called by Android for every incoming SMS. BROADCAST_SMS means only the
             system can call it, so other apps cannot feed it fake messages. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Reads chat notifications (RCS, MMS, WhatsApp) once you allow "Notification access".
             BIND_NOTIFICATION_LISTENER_SERVICE means only the system can connect to it. -->
        <service
            android:name=".ChatListener"
            android:exported="true"
            android:label="Sajag"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>