<?xml version="1.0" encoding="utf-8"?>
<!-- Home: the wordmark, whether this phone is protected, two checks and the latest results. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wordmark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:contentDescription="Sajag"
                android:fontFamily="@font/rozha_one"
                android:includeFontPadding="false"
                android:paddingTop="6dp"
                android:text="सजग"
                android:textColor="@color/ivory"
                android:textSize="36sp" />

            <FrameLayout
                android:id="@+id/btn_help"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_icon_button"
                android:clickable="true"
                android:contentDescription="How Sajag works"
                android:focusable="true">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_help"
                    android:tint="@color/text_2" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/status_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <FrameLayout
                android:id="@+id/status_icon_box"
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/status_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_shield_check" />
            </FrameLayout>

            <TextView
                android:id="@+id/status_title"
                style="@style/Sajag.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/status_text"
                style="@style/Sajag.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="5sp" />

            <TextView
                android:id="@+id/status_action"
                style="@style/Sajag.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="46dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tile_phone_label"
                        style="@style/Sajag.Text"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/figtree_semibold"
                        android:maxLines="1"
                        android:text="This phone"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tile_phone"
                        style="@style/Sajag.Text"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="4dp"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/figtree_bold"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_hub_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tile_hub_label"
                        style="@style/Sajag.Text"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/figtree_semibold"
                        android:maxLines="1"
                        android:text="Home Hub"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tile_hub"
                        style="@style/Sajag.Text"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="4dp"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/figtree_bold"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tile_explain_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tile"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tile_explain_label"
                        style="@style/Sajag.Text"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:autoSizeMaxTextSize="12sp"
                        android:autoSizeMinTextSize="9sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/figtree_semibold"
                        android:maxLines="1"
                        android:text="Explanations"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tile_explain"
                        style="@style/Sajag.Text"
                        android:layout_width="match_parent"
                        android:layout_height="20dp"
                        android:layout_marginTop="4dp"
                        android:autoSizeMaxTextSize="15sp"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="@font/figtree_bold"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btn_check_message"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chat"
                    android:tint="@color/ink" />

                <TextView
                    style="@style/Sajag.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_bold"
                    android:maxLines="1"
                    android:text="Check a message"
                    android:textSize="15sp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_check_link"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_tonal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_link"
                    android:tint="@color/ivory" />

                <TextView
                    style="@style/Sajag.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/figtree_bold"
                    android:maxLines="1"
                    android:text="Check a link"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/waiting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clock"
                android:tint="@color/text_2" />

            <TextView
                android:id="@+id/waiting_text"
                style="@style/Sajag.Text.Sub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_2" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Sajag.Text.H2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent" />

            <TextView
                android:id="@+id/see_all"
                style="@style/Sajag.Button.Text"
                android:layout_width="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="See all" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recent_list"
            style="@style/Sajag.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/recent_empty"
            style="@style/Sajag.Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:text="Nothing checked yet. New messages appear here, with what Sajag found."
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
