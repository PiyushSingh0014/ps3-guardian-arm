<?xml version="1.0" encoding="utf-8"?>
<!-- Home network: what the Home Hub sees on the home Wi-Fi, riskiest devices first. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Sajag.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:text="Home network" />

        <LinearLayout
            android:id="@+id/net_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                style="@style/Sajag.Text.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Network checks are off" />

            <TextView
                style="@style/Sajag.Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Turn them on to see what your Home Hub finds on your home Wi-Fi, and to get its alerts." />

            <TextView
                android:id="@+id/btn_net_on"
                style="@style/Sajag.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="14dp"
                android:minHeight="46dp"
                android:text="Turn on" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/net_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/net_summary_icon_box"
                    android:layout_width="44dp"
                    android:layout_height="44dp">

                    <ImageView
                        android:id="@+id/net_summary_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <TextView
                    android:id="@+id/net_summary_title"
                    style="@style/Sajag.Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/figtree_extrabold"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/net_summary_chevron"
                    style="@style/Sajag.Chevron" />
            </LinearLayout>

            <TextView
                android:id="@+id/net_summary_text"
                style="@style/Sajag.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4sp"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            style="@style/Sajag.Text.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Devices, riskiest first" />

        <LinearLayout
            android:id="@+id/dev_list"
            style="@style/Sajag.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/dev_empty"
            style="@style/Sajag.Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:visibility="gone" />

        <TextView
            style="@style/Sajag.Text.H2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Network alerts" />

        <LinearLayout
            android:id="@+id/net_list"
            style="@style/Sajag.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/net_empty"
            style="@style/Sajag.Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/net_status"
            style="@style/Sajag.Text.Note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="4dp" />
    </LinearLayout>
</ScrollView>
