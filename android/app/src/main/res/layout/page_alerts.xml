<?xml version="1.0" encoding="utf-8"?>
<!-- Alerts: every checked message, newest first, by day; All, Scams or Safe. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Sajag.Text.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:text="Alerts" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                style="@style/Sajag.Chip"
                android:layout_width="wrap_content"
                android:text="All" />

            <TextView
                android:id="@+id/chip_scams"
                style="@style/Sajag.Chip"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Scams" />

            <TextView
                android:id="@+id/chip_safe"
                style="@style/Sajag.Chip"
                android:layout_width="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Safe" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alerts_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/alerts_empty"
            style="@style/Sajag.Text.Sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:padding="18dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
