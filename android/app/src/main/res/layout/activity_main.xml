<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PS3 Guardian"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guard_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Phone Guard: loading..." />

        <TextView
            android:id="@+id/llama_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Llama on this phone: checking..." />

        <Button
            android:id="@+id/get_llama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get Llama from the Pi (about 1 GB)" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Pi address" />

        <EditText
            android:id="@+id/pi_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://10.42.0.1:8443"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pairing token (on the Pi: cat ~/.ps3_guardian_token)" />

        <EditText
            android:id="@+id/token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone name (marks this phone's messages in the Pi's log, for example A)" />

        <EditText
            android:id="@+id/device"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLength="32" />

        <CheckBox
            android:id="@+id/study"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Share message texts with the team's study" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Off: the Pi keeps each message's verdict and its sender ID (only 'mobile number' for a person), never the text. On: it also keeps the text of messages from businesses and of flagged messages, digits hidden, so the team can label them; the Pi must also have this phone on its study list. You can switch it off at any time." />

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save" />

        <Button
            android:id="@+id/permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow SMS and notifications" />

        <Button
            android:id="@+id/pair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pair with the Pi" />

        <Button
            android:id="@+id/test_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Test connection" />

        <Button
            android:id="@+id/test_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send a test scam" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Chats (RCS and WhatsApp)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Only chats from numbers that are not in your contacts are checked." />

        <CheckBox
            android:id="@+id/chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check chats in Messages (RCS)" />

        <CheckBox
            android:id="@+id/chat_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Check WhatsApp chats" />

        <CheckBox
            android:id="@+id/chat_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Also check chats from saved contacts (for testing)" />

        <Button
            android:id="@+id/notification_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Allow notification access" />

        <TextView
            android:id="@+id/chat_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Network alerts (the Pi's Wi-Fi)"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What the Pi's network monitor finds on PS3-Guardian-Lab, for every device there. The app asks the Pi about once a minute, every 10 s while this screen is open, and shows new alerts as notifications. Each device gets a risk level from its alerts of the last 24 hours: at risk (a dangerous one), check (a suspicious one) or OK." />

        <CheckBox
            android:id="@+id/net_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show network alerts and notify me" />

        <TextView
            android:id="@+id/net_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Devices, riskiest first"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dev_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="Alerts, newest first"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/net_alerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textIsSelectable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="Recent messages"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
