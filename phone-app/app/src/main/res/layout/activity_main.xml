<?xml version="1.0" encoding="utf-8"?>
<!-- Sajag (app 3.0): four pages and the bar that switches between them. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ground"
    android:orientation="vertical">

    <View
        android:id="@+id/status_space"
        android:layout_width="match_parent"
        android:layout_height="0dp" />

    <FrameLayout
        android:id="@+id/pages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/page_home"
            layout="@layout/page_home" />

        <include
            android:id="@+id/page_alerts"
            layout="@layout/page_alerts"
            android:visibility="gone" />

        <include
            android:id="@+id/page_network"
            layout="@layout/page_network"
            android:visibility="gone" />

        <include
            android:id="@+id/page_settings"
            layout="@layout/page_settings"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nav"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="10dp"
        android:paddingEnd="6dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/tab_home"
            style="@style/Sajag.NavTab"
            android:contentDescription="Home">

            <FrameLayout
                android:id="@+id/tab_home_pill"
                style="@style/Sajag.NavPill">

                <ImageView
                    android:id="@+id/tab_home_icon"
                    style="@style/Sajag.NavIcon"
                    android:src="@drawable/ic_shield" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_home_label"
                style="@style/Sajag.NavLabel"
                android:text="Home" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_alerts"
            style="@style/Sajag.NavTab"
            android:contentDescription="Alerts">

            <FrameLayout
                android:id="@+id/tab_alerts_pill"
                style="@style/Sajag.NavPill">

                <ImageView
                    android:id="@+id/tab_alerts_icon"
                    style="@style/Sajag.NavIcon"
                    android:src="@drawable/ic_bell" />

                <TextView
                    android:id="@+id/tab_alerts_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="16dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="1dp"
                    android:layout_marginEnd="13dp"
                    android:background="@drawable/bg_badge"
                    android:fontFamily="@font/figtree_extrabold"
                    android:gravity="center"
                    android:minWidth="16dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="@color/ink"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_alerts_label"
                style="@style/Sajag.NavLabel"
                android:text="Alerts" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_network"
            style="@style/Sajag.NavTab"
            android:contentDescription="Network">

            <FrameLayout
                android:id="@+id/tab_network_pill"
                style="@style/Sajag.NavPill">

                <ImageView
                    android:id="@+id/tab_network_icon"
                    style="@style/Sajag.NavIcon"
                    android:src="@drawable/ic_wifi" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_network_label"
                style="@style/Sajag.NavLabel"
                android:text="Network" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            style="@style/Sajag.NavTab"
            android:contentDescription="Settings">

            <FrameLayout
                android:id="@+id/tab_settings_pill"
                style="@style/Sajag.NavPill">

                <ImageView
                    android:id="@+id/tab_settings_icon"
                    style="@style/Sajag.NavIcon"
                    android:src="@drawable/ic_sliders" />
            </FrameLayout>

            <TextView
                android:id="@+id/tab_settings_label"
                style="@style/Sajag.NavLabel"
                android:text="Settings" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
