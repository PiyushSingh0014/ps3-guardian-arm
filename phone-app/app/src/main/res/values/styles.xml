<?xml version="1.0" encoding="utf-8"?>
<!-- Sajag (app 3.0): type, buttons and rows. Buttons are TextViews with their own background,
     so the theme's button styling never changes them. -->
<resources>
    <style name="Sajag" />

    <style name="Sajag.Text">
        <item name="android:fontFamily">@font/figtree_regular</item>
        <item name="android:textColor">@color/ivory</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="Sajag.Text.Title">
        <item name="android:fontFamily">@font/figtree_extrabold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="Sajag.Text.H2">
        <item name="android:fontFamily">@font/figtree_extrabold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Sajag.Text.Label">
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:paddingStart">4dp</item>
    </style>
    <style name="Sajag.Text.Body">
        <item name="android:textColor">@color/body</item>
        <item name="android:lineSpacingExtra">6sp</item>
    </style>
    <style name="Sajag.Text.Sub">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:lineSpacingExtra">3sp</item>
    </style>
    <style name="Sajag.Text.Note">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_3</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>
    <style name="Sajag.Text.RowTitle">
        <item name="android:fontFamily">@font/figtree_bold</item>
    </style>
    <style name="Sajag.Text.Value">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="Sajag.Button">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Sajag.Button.Primary">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Sajag.Button.Tonal">
        <item name="android:background">@drawable/bg_button_tonal</item>
        <item name="android:textColor">@color/ivory</item>
    </style>
    <style name="Sajag.Button.Danger">
        <item name="android:background">@drawable/bg_button_danger</item>
        <item name="android:textColor">@color/danger_ink</item>
        <item name="android:fontFamily">@font/figtree_extrabold</item>
    </style>
    <style name="Sajag.Button.Text">
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Sajag.Chip">
        <item name="android:layout_height">40dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:fontFamily">@font/figtree_bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Sajag.Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- A settings row that opens something: title, value, chevron. -->
    <style name="Sajag.Row">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <!-- A row with a switch: title and a line under it. -->
    <style name="Sajag.SwitchRow">
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">72dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="Sajag.Toggle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:thumb">@drawable/switch_thumb</item>
        <item name="android:track">@drawable/switch_track</item>
        <item name="android:switchMinWidth">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:showText">false</item>
        <item name="android:background">@null</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Sajag.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>
    <style name="Sajag.Chevron">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:src">@drawable/ic_chevron</item>
        <item name="android:tint">@color/text_3</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="Sajag.NavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:background">@drawable/bg_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    <style name="Sajag.NavPill">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">32dp</item>
    </style>
    <style name="Sajag.NavIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="Sajag.NavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/figtree_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_3</item>
    </style>
</resources>
