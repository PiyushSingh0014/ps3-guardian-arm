<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Sajag (app 3.0): one dark look, charcoal and ivory, in day and night alike. -->
    <style name="Base.Theme.PS3Guardian" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/ivory</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorSecondary">@color/text_2</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ivory</item>
        <item name="colorError">@color/danger</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/ivory</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:textColorHint">@color/text_3</item>
        <item name="android:textColorHighlight">#665E5A52</item>
        <item name="android:colorControlActivated">@color/ivory</item>
        <item name="android:colorControlNormal">@color/text_3</item>
        <!-- Only android:fontFamily. AppCompat lets a theme's app:fontFamily win over every view's own
             font, which turned the wordmark and all the bold titles into Figtree Regular (app 3.0). -->
        <item name="android:fontFamily">@font/figtree_regular</item>
    </style>

    <style name="Theme.PS3Guardian" parent="Base.Theme.PS3Guardian" />
</resources>
