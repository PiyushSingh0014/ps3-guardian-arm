<?xml version="1.0" encoding="utf-8"?>
<!-- The app talks only to the Pi, and only over HTTPS (update 39): no plain HTTP at all. The Pi's
     certificate is its own, so no certificate authority vouches for it; the app trusts exactly the
     certificate its owner confirmed when pairing (Tls.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
